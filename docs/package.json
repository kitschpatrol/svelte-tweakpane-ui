{
	"name": "svelte-tweakpane-ui-docs",
	"version": "1.0.0",
	"private": true,
	"description": "Documentation website for Svelte Tweakpane UI.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/svelte-tweakpane-ui.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "shx mkdir -p ./src/content/acknowledgments && pnpm licenses list --json > ./src/content/acknowledgments/acknowledgments-docs.json.tmp && shx mv ./src/content/acknowledgments/acknowledgments-docs.json.tmp ./src/content/acknowledgments/acknowledgments-docs.json && astro build",
		"clean": "rm -rf .astro && rm -rf dist",
		"dev": "astro dev",
		"preview": "poptab ; open https://localhost:8787/svelte-tweakpane-ui ; wrangler dev --show-interactive-dev-session false --https-cert-path ~/.vite-plugin-mkcert/cert.pem --https-key-path ~/.vite-plugin-mkcert/dev.pem",
		"start": "astro dev",
		"sync": "astro sync"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/starlight": "^0.42.0",
		"@astrojs/svelte": "^9.0.1",
		"astro": "^7.3.1",
		"astro-html-kit": "^0.5.2",
		"canvas": "^3.2.3",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"marked": "^18.0.11",
		"poptab": "^1.2.0",
		"sharp": "^0.35.4",
		"shx": "^0.4.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-tweakpane-ui": "link:..",
		"wrangler": "^4.127.1"
	}
}
